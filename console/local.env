# Local stack values. They match docker-compose.yml and are not secrets.
# The npm scripts load this file directly; put overrides in .env.local (gitignored).
#
# On Vercel, DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct) are injected by the
# Neon integration from the Vercel Marketplace. Locally both point at the same PostgreSQL.
DATABASE_URL=postgresql://poc:poc-local-only@127.0.0.1:54329/poc
DATABASE_URL_UNPOOLED=postgresql://poc:poc-local-only@127.0.0.1:54329/poc

# Base URL of the Umami deployment the gateway forwards to. Set by hand on Vercel.
UMAMI_URL=http://127.0.0.1:3301
# Umami without its geo database (tests only), see docker-compose.yml.
UMAMI_NOGEO_URL=http://127.0.0.1:3302

# Used only by scripts/seed.mjs and the tests, never by the deployed functions.
UMAMI_ADMIN_USER=admin
UMAMI_ADMIN_PASSWORD=umami

# Local development server (dev.mjs) and tests only.
GATEWAY_PORT=4300
DEMO_PORT=4301
GATEWAY_URL=http://localhost:4300
DEMO_URL=http://localhost:4301

# Secret that Vercel sends to the sample traffic job (/api/cron/sample-traffic, DECISIONS 47);
# without it the route answers 401. Unset here: the tests set their own.
# CRON_SECRET=

# The demo API (DECISIONS 59): where /v1/metrics is, and Demo site A's ingest token. Unset here,
# so the scheduled run calls no demo API; npm run demo-api-check sets both for itself.
# CONSOLE_URL=http://localhost:4300
# DEMO_API_INGEST_TOKEN=
