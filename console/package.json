{
  "name": "usage-signals-poc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/seed.mjs",
    "up": "docker compose up -d --wait && node --env-file=local.env --env-file-if-exists=.env.local scripts/seed.mjs && node --env-file=local.env --env-file-if-exists=.env.local dev.mjs",
    "test": "node --env-file=local.env --env-file-if-exists=.env.local --test --test-concurrency=1 \"test/*.test.mjs\"",
    "pin-tracker": "node scripts/pin-tracker.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.11.3",
    "pg": "8.23.1"
  },
  "license": "Apache-2.0"
}
