. console/.husky/gitleaks.sh

# Scans each pushed range git sends on stdin (<local ref> <local sha> <remote ref> <remote sha>).
z=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z" ] && continue
  if [ "$remote_sha" = "$z" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  gitleaks git --redact --verbose --log-opts="$range" . || rc=1
done
exit "$rc"
